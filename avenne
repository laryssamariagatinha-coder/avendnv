-- UTILS
local Utils = {}
function Utils.getHRP(plr) return plr and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") end
function Utils.getHumanoid(plr) return plr and plr.Character and plr.Character:FindFirstChildOfClass("Humanoid") end
function Utils.getRigType(c)
    if not c then return "?" end
    if c:FindFirstChild("UpperTorso") or c:FindFirstChild("LowerTorso") then return "R15" end
    if c:FindFirstChild("Torso") then return "R6" end
    return "?"
end
function Utils.getAllParts(c)
    local t = {}
    if not c then return t end
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") then table.insert(t, p) end
    end
    return t
end
function Utils.clamp(v, mn, mx) return math.max(mn, math.min(mx, v)) end
function Utils.round(v, p) p = p or 0; local m = 10^p; return math.floor(v*m+0.5)/m end
function Utils.safeCall(fn, ...) local ok, err = pcall(fn, ...); if not ok then warn("[Aven]", err) end; return ok, err end

