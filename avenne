local function tocarEmote(nome)
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    local rig = Utils.getRigType(char)
    local info
    for _, e in ipairs(EMOTES) do if e.nome == nome then info = e; break end end

    if rig == "R15" then
        pcall(function() hum:PlayEmote(nome) end)
        toast(nome, CFG.SUCCESS)
    elseif rig == "R6" then
        if info and info.r6 then
            pcall(function()
                local ChatSvc = game:GetService("Chat")
                if ChatSvc and ChatSvc.Chat then ChatSvc:Chat(hum, "/e "..nome)
                else StarterGui:SetCore("ChatMakeSystemMessage", {Text = "/e "..nome, Color = Color3.new()}) end
            end)
            toast(nome.." (R6)", CFG.SUCCESS)
        else
            toast(nome.." só R15", CFG.WARN)
        end
    end
end

